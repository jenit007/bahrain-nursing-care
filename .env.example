# ============================================================================
# NOOR AL AFIYA — ENVIRONMENT CONFIGURATION (.env.example)
# Copy this file to `.env` and fill in your real values.
# NEVER commit `.env` to version control or expose backend secrets in VITE_*!
# ============================================================================

# ----------------------------------------------------------------------------
# 1. SUPABASE POSTGRESQL CONNECTION (PRISMA)
# Found in: Supabase Dashboard -> Connect (top bar) -> ORM -> Prisma
# ----------------------------------------------------------------------------
# Pooled connection string (Transaction pooler, port 6543, append ?pgbouncer=true)
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct / Session pooler connection string for Prisma migrations (port 5432)
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-DB-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ----------------------------------------------------------------------------
# 2. SUPABASE AUTHENTICATION (FRONTEND + BACKEND)
# Found in: Supabase Dashboard -> Project Settings -> API
# Safe for browser bundle: VITE_SUPABASE_URL and VITE_SUPABASE_ANON_KEY
# ----------------------------------------------------------------------------
VITE_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-publishable-key"

# ----------------------------------------------------------------------------
# 3. SUPABASE SERVER-SIDE CREDENTIALS (BACKEND ONLY — NEVER EXPOSE IN VITE_*)
# Found in: Supabase Dashboard -> Project Settings -> API
# ----------------------------------------------------------------------------
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-publishable-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-secret-key"
SUPABASE_STORAGE_BUCKET="job-applications"

# ----------------------------------------------------------------------------
# 4. EXPRESS BACKEND & SECURITY CONFIGURATION
# ----------------------------------------------------------------------------
NODE_ENV="development"
PORT=4000
CORS_ORIGIN="http://localhost:5173,https://bahrain-nursing-care.vercel.app"
SESSION_SECRET="replace-with-a-strong-random-64-character-hex-secret-key"

# ----------------------------------------------------------------------------
# 5. ADMIN CLI AUTHORIZATION (Optional — used only by `npm run db:seed`)
# Links an existing user created in Supabase Dashboard -> Authentication -> Users
# ----------------------------------------------------------------------------
INITIAL_ADMIN_NAME=""
INITIAL_ADMIN_EMAIL=""

# ----------------------------------------------------------------------------
# 6. FRONTEND API BASE URL
# Leave empty in local development to use the Vite `/api` proxy,
# or set to your deployed Express backend URL in production
# ----------------------------------------------------------------------------
VITE_API_BASE_URL=""
